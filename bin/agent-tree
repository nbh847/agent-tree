#!/usr/bin/env bash
# agent-tree 启动脚本：免安装运行，仅用标准库。
# 用法与 `python3 -m agent_tree` 完全一致，参数原样透传。
#   bin/agent-tree              # 在 tmux 当前 window 左侧创建侧栏
#   bin/agent-tree --snapshot   # 一次性打印聚合树
set -euo pipefail

# 解析脚本所在项目根目录，兼容软链接调用。
source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
    link_target="$(readlink "$source_path")"
    case "$link_target" in
        /*) source_path="$link_target" ;;
        *) source_path="$(dirname "$source_path")/$link_target" ;;
    esac
done
root="$(cd "$(dirname "$source_path")/.." && pwd)"

# 选择可用的 Python 3.13+ 解释器。优先使用项目内 venv（界面依赖 textual 装在其中）。
pick_python() {
    local candidate
    for candidate in "${AGENT_TREE_PYTHON:-}" "$root/.venv/bin/python" python3.14 python3.13 python3; do
        [ -n "$candidate" ] || continue
        if command -v "$candidate" >/dev/null 2>&1 \
            && "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 13) else 1)' 2>/dev/null; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

if ! python_bin="$(pick_python)"; then
    echo "agent-tree: 未找到 Python 3.13+ 解释器（可用 AGENT_TREE_PYTHON 指定）" >&2
    exit 1
fi

if ! command -v tmux >/dev/null 2>&1; then
    echo "agent-tree: 未找到 tmux" >&2
    exit 1
fi

export PYTHONPATH="$root/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$python_bin" -m agent_tree "$@"
